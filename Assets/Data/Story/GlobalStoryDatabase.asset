  Chapters:
  - ChapterId: ch_01
    ChapterTitle: "B\xF6l\xFCm 1: \u0130lk Ad\u0131mlar"
    Lines:
    - Speaker: {fileID: 11400000, guid: 70b13114d47f84547b2416ecaad9ee8a, type: 2}
      IsPlayerSide: 1
      Text: "Neredeyim ben? Buras\u0131 \xE7ok karanl\u0131k..."
      IsPausePoint: 0
    - Speaker: {fileID: 11400000, guid: 42335e7bed087bf42965fa5c1270592a, type: 2}
      IsPlayerSide: 0
      Text: "Korkma, g\xFCvendesin. Ben sana rehberlik edece\u011Fim."
      IsPausePoint: 0
    - Speaker: {fileID: 11400000, guid: 70b13114d47f84547b2416ecaad9ee8a, type: 2}
      IsPlayerSide: 1
      Text: Peki ne yapmam gerekiyor?
      IsPausePoint: 1
