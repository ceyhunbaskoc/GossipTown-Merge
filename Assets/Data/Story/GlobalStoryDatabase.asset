  - ChapterId: ch_02
    ChapterTitle: "B\xF6l\xFCm 2: Kurulum"
    Lines:
    - Speaker: {fileID: 11400000, guid: 42335e7bed087bf42965fa5c1270592a, type: 2}
      IsPlayerSide: 0
      Text: "\u0130lk binan\u0131 ba\u015Far\u0131yla in\u015Fa ettin."
      IsPausePoint: 0
    - Speaker: {fileID: 11400000, guid: 70b13114d47f84547b2416ecaad9ee8a, type: 2}
      IsPlayerSide: 1
      Text: "Evet, kaynaklar\u0131 y\xF6netmek zor olmad\u0131."
      IsPausePoint: 1
